  <DataSets>
    <DataSet Name="DSCat">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Productos" ColumnName="Nombre" />
              <ColumnExpression Schema="Inventario" ColumnOwner="CATEGORIA" ColumnName="Nombre" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="CATEGORIA" Schema="Inventario" />
              <Join Type="INNER JOIN" ColumnOwner="Productos">
                <On>
                  <From ColumnOwner="CATEGORIA" Schema="Inventario" ColumnName="IDCategoria" />
                  <To ColumnOwner="Productos" ColumnName="IDCategoria" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Productos.Nombre AS [Productos Nombre]
  ,Inventario.CATEGORIA.Nombre AS [CATEGORIA Nombre]
FROM
  Inventario.CATEGORIA
  INNER JOIN Productos
    ON Inventario.CATEGORIA.IDCategoria = Productos.IDCategoria</CommandText>
      </Query>
      <Fields>
        <Field Name="Productos_Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Productos Nombre</DataField>
        </Field>
        <Field Name="CATEGORIA_Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CATEGORIA Nombre</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
