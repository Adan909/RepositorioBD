  <DataSets>
    <DataSet Name="DSPedidos">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Pedido" ColumnName="IDPedido" />
              <ColumnExpression ColumnOwner="Clientes" ColumnName="Nombres" />
              <ColumnExpression ColumnOwner="Pedido" ColumnName="fechaPedido" />
              <ColumnExpression ColumnOwner="Pedido" ColumnName="Estado" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Clientes" />
              <Join Type="INNER JOIN" ColumnOwner="Pedido">
                <On>
                  <From ColumnOwner="Clientes" ColumnName="IDCliente" />
                  <To ColumnOwner="Pedido" ColumnName="IDCliente" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Pedido.IDPedido
  ,Clientes.Nombres
  ,Pedido.fechaPedido
  ,Pedido.Estado
FROM
  Clientes
  INNER JOIN Pedido
    ON Clientes.IDCliente = Pedido.IDCliente</CommandText>
      </Query>
      <Fields>
        <Field Name="IDPedido">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>IDPedido</DataField>
        </Field>
        <Field Name="Nombres">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombres</DataField>
        </Field>
        <Field Name="fechaPedido">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>fechaPedido</DataField>
        </Field>
        <Field Name="Estado">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Estado</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
