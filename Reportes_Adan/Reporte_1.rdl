  <DataSets>
    <DataSet Name="DSTiendaOnline">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Clientes" ColumnName="Nombres" />
              <ColumnExpression ColumnOwner="Pedido" ColumnName="IDPedido" />
              <ColumnExpression ColumnOwner="Productos" ColumnName="Nombre" />
              <ColumnExpression ColumnOwner="Clientes" ColumnName="Pais" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Pedido" />
              <Join Type="INNER JOIN" ColumnOwner="Clientes">
                <On>
                  <From ColumnOwner="Pedido" ColumnName="IDCliente" />
                  <To ColumnOwner="Clientes" ColumnName="IDCliente" />
                </On>
              </Join>
              <Join Type="INNER JOIN" ColumnOwner="Productos">
                <On>
                  <From ColumnOwner="Pedido" ColumnName="IDProducto" />
                  <To ColumnOwner="Productos" ColumnName="IDProducto" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Clientes.Nombres
  ,Pedido.IDPedido
  ,Productos.Nombre
  ,Clientes.Pais
FROM
  Pedido
  INNER JOIN Clientes
    ON Pedido.IDCliente = Clientes.IDCliente
  INNER JOIN Productos
    ON Pedido.IDProducto = Productos.IDProducto</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombres">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombres</DataField>
        </Field>
        <Field Name="IDPedido">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>IDPedido</DataField>
        </Field>
        <Field Name="Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombre</DataField>
        </Field>
        <Field Name="Pais">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Pais</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
