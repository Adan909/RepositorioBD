  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Clientes" ColumnName="Nombres" />
              <ColumnExpression ColumnOwner="Clientes" ColumnName="Apellidos" />
              <ColumnExpression ColumnOwner="Clientes" ColumnName="Email" />
              <ColumnExpression ColumnOwner="Clientes" ColumnName="Pais" />
              <ColumnExpression ColumnOwner="Clientes" ColumnName="Ciudad" />
              <ColumnExpression Schema="ClienteTelefono" ColumnOwner="Telefonos" ColumnName="Numero" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Clientes" />
              <Join Type="INNER JOIN" ColumnOwner="Telefonos" Schema="ClienteTelefono">
                <On>
                  <From ColumnOwner="Clientes" ColumnName="IDCliente" />
                  <To ColumnOwner="Telefonos" Schema="ClienteTelefono" ColumnName="IDCliente" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Clientes.Nombres
  ,Clientes.Apellidos
  ,Clientes.Email
  ,Clientes.Pais
  ,Clientes.Ciudad
  ,ClienteTelefono.Telefonos.Numero
FROM
  Clientes
  INNER JOIN ClienteTelefono.Telefonos
    ON Clientes.IDCliente = ClienteTelefono.Telefonos.IDCliente</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombres">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombres</DataField>
        </Field>
        <Field Name="Apellidos">
