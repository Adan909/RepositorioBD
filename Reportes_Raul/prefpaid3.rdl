  </DataSources>
  <DataSets>
    <DataSet Name="DSTIendaOnline1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    dp.MetodoPago AS [Metodo_Pago],
    COUNT(DISTINCT dp.IDPedido) AS [Total_Pedidos]
FROM dbo.DetallePedido dp
GROUP BY dp.MetodoPago;</CommandText>
      </Query>
      <Fields>
        <Field Name="Metodo_Pago">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Metodo_Pago</DataField>
        </Field>
        <Field Name="Total_Pedidos">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Total_Pedidos</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
