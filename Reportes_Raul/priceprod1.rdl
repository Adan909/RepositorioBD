  <DataSets>
    <DataSet Name="DSVentas">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression Schema="Inventario" ColumnOwner="CATEGORIA" ColumnName="Nombre" />
              <ColumnExpression ColumnOwner="Productos" ColumnName="Nombre" />
              <ColumnExpression ColumnOwner="DetallePedido" ColumnName="cantidad" />
              <ColumnExpression ColumnOwner="DetallePedido" ColumnName="precioUnitario" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Productos" />
              <Join Type="INNER JOIN" ColumnOwner="CATEGORIA" Schema="Inventario">
                <On>
                  <From ColumnOwner="Productos" ColumnName="IDCategoria" />
                  <To ColumnOwner="CATEGORIA" Schema="Inventario" ColumnName="IDCategoria" />
                </On>
              </Join>
              <Join Type="INNER JOIN" ColumnOwner="DetallePedido">
                <On>
                  <From ColumnOwner="Productos" ColumnName="IDProducto" />
                  <To ColumnOwner="DetallePedido" ColumnName="IDProducto" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Inventario.CATEGORIA.Nombre AS [CATEGORIA Nombre]
  ,Productos.Nombre AS [Productos Nombre]
  ,DetallePedido.cantidad
  ,DetallePedido.precioUnitario
FROM
  Productos
  INNER JOIN Inventario.CATEGORIA
    ON Productos.IDCategoria = Inventario.CATEGORIA.IDCategoria
  INNER JOIN DetallePedido
    ON Productos.IDProducto = DetallePedido.IDProducto</CommandText>
      </Query>
      <Fields>
        <Field Name="CATEGORIA_Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CATEGORIA Nombre</DataField>
        </Field>
        <Field Name="Productos_Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Productos Nombre</DataField>
        </Field>
        <Field Name="cantidad">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>cantidad</DataField>
        </Field>
        <Field Name="precioUnitario">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>precioUnitario</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
